{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Madina POS - default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    
    "log:default",
    "log:allow-log",

    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",

    "fs:default",
    "fs:allow-app-read",
    "fs:allow-app-write",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-copy-file",
    "fs:allow-rename",

    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",

    "opener:default",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",

    "printer:default",
    "printer:allow-get-printers",
    "printer:allow-get-printer",
    "printer:allow-get-default-printer",
    "printer:allow-get-printer-capabilities",
    "printer:allow-print-pdf",
    "printer:allow-print-pdf-data"
  ]
}